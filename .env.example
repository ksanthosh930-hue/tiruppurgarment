# DigiGarment Production Environment Variables
# Copy these keys into your Render Dashboard -> Environment Variables section

# 1. Supabase PostgreSQL Connection String (Session Pooler recommended with sslmode=require)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# 2. Admin Authentication & Session Security
ADMIN_INITIAL_PASSWORD=your_secure_admin_password_2026
SECRET_KEY=your_random_secret_string_for_jwt_and_sessions

# 3. Server Port (Render sets this automatically via $PORT)
PORT=8000
