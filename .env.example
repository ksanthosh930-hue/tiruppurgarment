# Tirupur Garments Configuration Example
# Copy this file to .env and fill in the values.

# Flask settings
SECRET_KEY=replace-with-a-very-secure-random-key-here
FLASK_APP=run.py
FLASK_ENV=development

# Database Settings
# Use your Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Admin Initial Credentials
ADMIN_EMAIL=admin@tirupurgarments.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password-here
